{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run LibMan0 (Build & Run Tomcat trong Terminal)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "${workspaceFolder}\\run.bat"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Tomcat (Cửa sổ riêng)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "${workspaceFolder}\\start-tomcat.bat"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop Tomcat",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "${workspaceFolder}\\stop-tomcat.bat"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}